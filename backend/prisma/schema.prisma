generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  DONE
  DEFERRED
  ISSUES
}

enum SubtaskStatus {
  IN_PROGRESS
  DONE
  DEFERRED
  CANCELLED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  COMMENTER
  VIEWER
}

enum MemberInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}


model tasks {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String          @db.Uuid
  title         String
  description   String          @default("")
  tags          String?
  start_date    String?
  due_date      String?
  creator       String?
  status        TaskStatus      @default(TODO)
  sort_order    Int             @default(0)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  workspaces    workspaces      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subtasks      subtasks[]
  task_activity task_activity[]
  task_status_history task_status_history[]

  @@index([workspace_id])
}

model task_status_history {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id     String      @db.Uuid
  from_status TaskStatus?
  to_status   TaskStatus
  user_id     Int?
  changed_at  DateTime    @default(now()) @db.Timestamptz(6)

  tasks tasks  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([changed_at])
}

model subtasks {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String   @db.Uuid
  user_id    Int?
  title      String
  status     SubtaskStatus @default(IN_PROGRESS)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  tasks tasks  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([user_id])
}

model task_activity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String   @db.Uuid
  user_id    Int?
  type       String
  title      String
  body       String?
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  tasks      tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([user_id])
  @@index([created_at])
}

model users {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password_hash String
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  
  workspaces    workspaces[]
  subtasks      subtasks[]
  task_activity task_activity[]
  task_status_history task_status_history[]

  workspace_members workspace_members[] @relation("WorkspaceMemberUser")
  invited_workspace_members workspace_members[] @relation("WorkspaceMemberInviter")
  workspace_invites workspace_invites[]
  received_member_invites workspace_member_invites[] @relation("MemberInviteInvitee")
  sent_member_invites workspace_member_invites[] @relation("MemberInviteInviter")
  user_llm_keys user_llm_keys[]
  user_connectors user_connectors[]
}

model user_connectors {
  user_id      Int
  connector_id String   @db.VarChar(32)
  enabled      Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, connector_id])
  @@index([user_id])
}

model workspaces {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey  String   @unique @map("public_key") @db.VarChar(50)
  user_id    Int
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  
  
  tasks      tasks[]
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  members workspace_members[]
  invites workspace_invites[]
  member_invites workspace_member_invites[]

  @@index([user_id])
}

  
model workspace_members {
  workspace_id String        @db.Uuid
  user_id      Int
  role         WorkspaceRole @default(EDITOR)
  invited_by   Int?
  permissions  Json?
  joined_at    DateTime      @default(now()) @db.Timestamptz(6)

  workspaces workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  users      users      @relation("WorkspaceMemberUser", fields: [user_id], references: [id], onDelete: Cascade)
  inviter    users?     @relation("WorkspaceMemberInviter", fields: [invited_by], references: [id], onDelete: SetNull)

  @@id([workspace_id, user_id])
  @@index([user_id])
}

model workspace_invites {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String        @unique
  workspace_id String        @db.Uuid
  created_by   Int
  role         WorkspaceRole @default(EDITOR)
  expires_at   DateTime      @db.Timestamptz(6)
  max_uses     Int           @default(1)
  uses         Int           @default(0)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)

  workspaces workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator    users      @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([expires_at])
}

model workspace_member_invites {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String             @db.Uuid
  invitee_id   Int
  invited_by   Int
  role         WorkspaceRole      @default(EDITOR)
  status       MemberInviteStatus @default(PENDING)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  responded_at DateTime?          @db.Timestamptz(6)

  workspaces workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  invitee    users      @relation("MemberInviteInvitee", fields: [invitee_id], references: [id], onDelete: Cascade)
  inviter    users      @relation("MemberInviteInviter", fields: [invited_by], references: [id], onDelete: Cascade)

  @@unique([workspace_id, invitee_id])
  @@index([invitee_id, status])
}

model user_llm_keys {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  label      String?  @db.VarChar(64)
  api_key    String
  key_hint   String?  @db.VarChar(32)
  is_active  Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
