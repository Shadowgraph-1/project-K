# Скопируй в .env и заполни своими значениями.

# Минимум 32 символа. Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI (LM Studio на хосте)
LM_BASE_URL=http://host.docker.internal:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=gemma-4-e4b-it

# Список админов через запятую
ADMIN_EMAILS=
