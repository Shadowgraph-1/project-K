# Локальная разработка без Docker (npm run dev).
# Для docker compose up — настрой Postgres в корневом .env, не здесь.

# Обязательные
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/kono
# Минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Auth / cookies / CORS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
COOKIE_SECRET=
NODE_ENV=development
# В development любой origin разрешён; в production также *.loca.lt, ngrok, trycloudflare.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# LLM (LM Studio). Опциональны — сервер запустится и без них,
# но /ai/* будет падать runtime, пока LM Studio не запущен.
LM_BASE_URL=http://localhost:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=gemma-4-e4b-it

# Сервисные (имеют дефолты)
PORT=3000
VERSION=1.0.0

# Админ-доступ (через запятую)
ADMIN_EMAILS=
# ADMIN_USER_IDS=1,2,3

# Telegram-коннектор
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEFAULT_CHAT_EMAIL=litvin4chuk@mail.ru
TELEGRAM_PROXY=socks5://127.0.0.1:10808