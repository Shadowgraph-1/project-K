# Локальная разработка (docker compose up). Не для продакшена.
# Скопируй: cp .env.example .env

# --- Postgres в Docker ---
# Для npm run dev в backend/ используй backend/.env и свой локальный Postgres (порт 5432).
# Для Docker — отдельная БД в контейнере; с хоста подключаешься на порт 5433.
POSTGRES_USER=kono
POSTGRES_PASSWORD=kono
POSTGRES_DB=kono
POSTGRES_HOST_PORT=5433

# Минимум 32 символа. Сгенерируй: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI (LM Studio на хосте; из контейнера — host.docker.internal)
LM_BASE_URL=http://host.docker.internal:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=gemma-4-e4b-it

# Список админов через запятую
ADMIN_EMAILS=

# Telegram-коннектор (для docker compose; в npm run dev — backend/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY=socks5://host.docker.internal:10808